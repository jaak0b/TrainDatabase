<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TrainDatabase.Presentation.ViewModels"
             x:Class="TrainDatabase.UI.Views.VehicleEditView"
             x:DataType="vm:VehicleEditViewModel">

    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="12" Margin="0,0,0,12">
            <Button Content="← Back to trains" Command="{Binding BackCommand}" />
            <TextBlock Text="{Binding Title, StringFormat='Edit · {0}'}" FontWeight="Bold" FontSize="16"
                       VerticalAlignment="Center" />
        </StackPanel>
        <ScrollViewer>
            <ContentControl Content="{Binding Settings}" />
        </ScrollViewer>
    </DockPanel>

</UserControl>
