<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TrainDatabase.Presentation.ViewModels"
             x:Class="TrainDatabase.UI.Views.VehicleEditView"
             x:DataType="vm:VehicleEditViewModel">

    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <Button DockPanel.Dock="Left" Content="← Back to trains" Command="{Binding BackCommand}" />
            <Button DockPanel.Dock="Right" Content="Delete vehicle" Command="{Binding DeleteCommand}" />
            <TextBlock Text="{Binding Title, StringFormat='Edit · {0}'}" FontWeight="Bold" FontSize="16"
                       VerticalAlignment="Center" Margin="12,0" />
        </DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
            <Button Content="Save" Command="{Binding Settings.SaveCommand}" />
            <Button Content="Revert" Command="{Binding Settings.RevertCommand}" />
        </StackPanel>
        <ContentControl Content="{Binding Settings}" />
    </DockPanel>

</UserControl>
