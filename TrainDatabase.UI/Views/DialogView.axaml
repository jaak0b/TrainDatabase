<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TrainDatabase.Presentation.Dialogs"
             x:Class="TrainDatabase.UI.Views.DialogView"
             x:DataType="vm:DialogViewModel">

    <Border Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
            CornerRadius="8" Padding="20" MaxWidth="440" MinWidth="320"
            BorderBrush="#40000000" BorderThickness="1">
        <StackPanel Spacing="12">
            <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="16" />
            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Content="Cancel" Command="{Binding CancelCommand}" IsVisible="{Binding ShowCancel}" />
                <Button Content="OK" Command="{Binding AcceptCommand}" Classes="accent" />
            </StackPanel>
        </StackPanel>
    </Border>

</UserControl>
