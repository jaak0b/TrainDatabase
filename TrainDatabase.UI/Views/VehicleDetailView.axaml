<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TrainDatabase.Presentation.ViewModels"
             x:Class="TrainDatabase.UI.Views.VehicleDetailView"
             x:DataType="vm:VehicleDetailViewModel">

    <Border Width="300" Margin="0,0,12,12" Padding="12" CornerRadius="8"
            BorderThickness="1" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
        <DockPanel>
            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,10">
                <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="14" TextTrimming="CharacterEllipsis" />
                    <Border IsVisible="{Binding HasTraction}" Background="{DynamicResource SystemAccentColor}"
                            CornerRadius="4" Padding="6,1" HorizontalAlignment="Left">
                        <TextBlock Text="{Binding TractionLabel}" FontSize="11" Foreground="White" />
                    </Border>
                </StackPanel>
                <Button Grid.Column="1" Content="✎" Command="{Binding EditCommand}" ToolTip.Tip="Edit train"
                        Padding="6,2" Margin="4,0,0,0" />
                <Button Grid.Column="2" Content="✕" Command="{Binding CloseCommand}" ToolTip.Tip="Close"
                        Padding="6,2" Margin="4,0,0,0" />
            </Grid>
            <ContentControl Content="{Binding Control}" />
        </DockPanel>
    </Border>

</UserControl>
