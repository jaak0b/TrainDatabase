<UserControl x:Class="Shell.WPF.Views.VehicleManualControlView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewModels="clr-namespace:Shell.WPF.ViewModels"
             xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
             xmlns:resx="clr-namespace:Shell.WPF.Resources"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="300"
             d:DataContext="{d:DesignInstance viewModels:VehicleManualControlViewModel }"
             PreviewMouseWheel="VehicleManualControlView_OnPreviewMouseWheel">
    <xctk:BusyIndicator IsBusy="{Binding IsDisconnected.Value, Mode=OneWay}"
                        BusyContent="{x:Static resx:Resources.LostConnectionToControlStation}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="AUTO" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="AUTO" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Slider Orientation="Vertical"
                    Grid.Row="0" Grid.Column="0"
                    VerticalAlignment="Stretch"
                    HorizontalAlignment="Center" Minimum="0"
                    Maximum="{Binding  VehiclePresenter.MaximumSpeedStep.Value}"
                    Value="{Binding VehicleSpeed.Value}"
                    Thumb.DragStarted="Thumb_OnDragStarted"
                    Thumb.DragCompleted="Thumb_OnDragCompleted" Width="30" />
            <ToggleButton Grid.Row="1" Grid.Column="0" IsChecked="{Binding VehicleDirection.Value}"
                          PreviewMouseDown="UIElement_OnPreviewMouseDown"
                          Content="{Binding VehicleDirectionDisplayText.Value}" />
        </Grid>
    </xctk:BusyIndicator>

</UserControl>