<Window x:Class="Shell.WPF.Views.VehicleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:viewModels="clr-namespace:Shell.WPF.ViewModels"
        mc:Ignorable="d"
        Title="{Binding VehicleViewModel.VehicleDisplayText.Value}" Height="450" Width="800"
        d:DataContext="{d:DesignInstance viewModels:VehicleWindowViewModel }">
        <TabControl>
            <TabItem Header="xxxx" Content="{Binding  VehicleManualControlView}"></TabItem>
            <TabItem Header="Settings" Content="{Binding VehicleSettingsView}"></TabItem>
            <TabItem Header="Zug Zusammenstellung"></TabItem>
        </TabControl>
</Window>